# Copy to .env and fill in. Never commit .env or the .p8 key.

# Public hostname of this proxy. Must resolve to this machine; Caddy obtains the TLS certificate for it.
PUSH_PROXY_DOMAIN=push.baitshook.com

# APNs authentication key (.p8) created in the Apple Developer portal under Certificates, Identifiers & Profiles > Keys.
# Either point at the file (Docker) or put the file's contents in APNS_KEY_PEM (hosted platforms with env secrets).
APNS_KEY_FILE=/keys/AuthKey.p8
#APNS_KEY_PEM=
APNS_KEY_ID=REPLACE_WITH_10_CHAR_KEY_ID
APNS_TEAM_ID=9Z63VM6NS2

# Must match PRODUCT_BUNDLE_IDENTIFIER of the GccTalk target. VoIP pushes use "<bundle>.voip" automatically.
APNS_BUNDLE_ID=com.gcc.Talk

# production = App Store / TestFlight builds. sandbox = builds installed from Xcode.
APNS_ENVIRONMENT=production

# Shown as the banner title/body only when the app's notification extension cannot decrypt the push.
APP_NAME=GCC Talk
NEW_NOTIFICATION_TEXT=You have a new notification

LOG_LEVEL=INFO
